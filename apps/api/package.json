{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:@prisma/client --external:.prisma --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "purge": "tsx --env-file=.env src/jobs/purge.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^1.5.2",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/emails": "workspace:*",
    "@repo/event-config": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.13",
    "hono": "^4.13.1",
    "pino": "^10.0.0",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
