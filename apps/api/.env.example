# Copie de travail : `pnpm setup:env` génère apps/api/.env avec des clés de dev fraîches.
# En production, TOUT vient de Scaleway Secret Manager — jamais de secret en clair (§3, §9).

NODE_ENV=development
PORT=3001

# Pool explicite (§5) — ajuster connection_limit selon max_connections du nœud
DATABASE_URL="postgresql://app:app@localhost:5433/adherents?connection_limit=10&pool_timeout=20"

# Clé de chiffrement des champs PII — format cloak (§6)
PRISMA_FIELD_ENCRYPTION_KEY="k1.aesgcm256.<base64url-43-chars>"
# Sel du blind index email — DISTINCT de la clé de chiffrement (§6)
PRISMA_FIELD_ENCRYPTION_HASH_SALT="<64-hex-chars>"
# Rotation : clés de déchiffrement supplémentaires, séparées par des virgules
# PRISMA_FIELD_DECRYPTION_KEYS=

# resend (prod) | devfile (dev : écrit dans .local/outbox) | memory (tests)
EMAIL_DRIVER=devfile
EMAIL_FROM="Connexion <auth@example.org>"
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Origine de la SPA : CORS (§9) + base des magic links
APP_ORIGIN=http://localhost:5173

# PostHog Cloud EU (events produit + erreurs serveur). Optionnel : sans clé, no-op.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
